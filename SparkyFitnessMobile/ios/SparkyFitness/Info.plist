	<string>$(RCT_METRO_PORT)</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>SparkyKeychainGroup</key>
	<string>$(AppIdentifierPrefix)group.net.thelloyds.sparkyfitness</string>
