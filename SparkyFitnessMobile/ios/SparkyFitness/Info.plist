		<string>fr</string>
		<string>hu</string>
		<string>it</string>
		<string>lv</string>
		<string>nb-NO</string>
		<string>nl</string>
		<string>pl</string>
		<string>pt-BR</string>
		<string>ru</string>
		<string>tr</string>
		<string>yue-Hant</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.8.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sparkyfitnessmobile</string>
				<string>net.thelloyds.sparkyfitness</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>exp+sparkyfitnessmobile</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ExpoWidgetsAppGroupIdentifier</key>
	<string>group.net.thelloyds.sparkyfitness</string>
	<key>ExpoWidgets_EnablePushNotifications</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_expo._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>SparkyFitness needs access to your camera to scan food barcodes and labels.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Allow $(PRODUCT_NAME) to access your Face ID biometric data.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>SparkyFitness reads Health data (such as activity, workouts, and body measurements) to display it in the app and sync it to your self-hosted SparkyFitness server.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>SparkyFitness writes the nutrition and hydration you log in the app to Apple Health, keeping the two in sync.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SparkyFitness connects to self-hosted servers on your local network.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SparkyFitness uses your location to record the route, distance and pace of your walks, runs and rides.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SparkyFitness uses the microphone so you can dictate messages in Chat.</string>
	<key>NSMotionUsageDescription</key>
	<string>SparkyFitness uses your step count to estimate the distance of indoor walks and runs, and to learn your stride from your recorded walks and runs.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SparkyFitness lets you choose photos from your library for your foods, meals, and diary entries.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>SparkyFitness uses speech recognition to turn voice input into chat text.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<false/>
